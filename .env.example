# ==============================================================================
# Truthy Deepfake Forensic Engine - Environment Configuration
# ==============================================================================

# Server Network Configuration
API_HOST=0.0.0.0
API_PORT=8080

# Client Authentication
# Comma-separated keys required for external API requests (via x-api-key header)
# Leave blank to allow open access or internal web frontend requests
API_KEYS=

# Hugging Face Inference API
# Recommended for cloud deployments to run audio models with zero local RAM usage
HF_TOKEN=

# Multimodal Arbitration & LLM Judge
# Supported modes: "weighted" (pure algorithmic ensemble), "hybrid" (LLM tiebreaker for borderline cases), "llm" (full qualitative evaluation)
JUDGE_MODE=weighted

# LLM Providers for Qualitative Reasoning & Borderline Arbitration
# Automatically selects Groq if set, otherwise falls back to Gemini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=

# Performance & Caching
# Pre-warm vision neural networks on startup (requires >= 2GB RAM; set true for production)
PREWARM_IMAGE_MODELS=false
